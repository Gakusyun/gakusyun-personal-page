---
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import type { NavBarLink } from "../types/config";
import { LinkPreset } from "../types/config";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

// Get all navigation links (same as navbar)
const links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			const key = item as keyof typeof LinkPresets;
			return LinkPresets[key];
		}
		return item;
	},
);
---

<MainGridLayout title="404" description="Page not found">
	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<div class="flex flex-col items-center justify-center py-12">
				<!-- 404 Title -->
				<div class="text-8xl font-bold text-[var(--primary)] mb-4">
					404
				</div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
					Page Not Found
				</h1>
				<p class="text-neutral-600 dark:text-neutral-400 mb-12 text-center max-w-lg">
					The page you're looking for doesn't exist or has been moved.
				</p>

				<!-- Custom Navigation Buttons -->
				<div class="flex flex-wrap gap-4 justify-center w-full max-w-2xl">
					{links.map((link) => (
						<a
							href={link.external ? link.url : url(link.url)}
							target={link.external ? "_blank" : null}
							class="group relative px-8 py-4 font-bold text-lg rounded-xl overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 border-[2px] border-[var(--primary)] bg-transparent hover:bg-[var(--primary)] text-[var(--primary)] hover:text-white"
						>
							<span class="relative z-10 flex items-center gap-2">
								{link.name}
							</span>
						</a>
					))}
				</div>

				<!-- Back to Home Link -->
				<a
					href={url("/")}
					class="mt-8 text-neutral-600 dark:text-neutral-400 hover:text-[var(--primary)] transition-colors duration-200 flex items-center gap-2"
				>
					<svg
						class="w-5 h-5"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M10 19l-7-7m0 0l7-7m-7 7h18"
						></path>
					</svg>
					Go back to homepage
				</a>
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	/* Custom 404 page animations */
	@keyframes float {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	.text-8xl {
		animation: float 3s ease-in-out infinite;
	}
</style>
